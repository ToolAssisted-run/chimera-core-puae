{
 "_comment": "This file lists the kinds of file a project of this core can hold. Chimera's New Project window is built from it. Each kind is called a slot. A project file records its files under the slot ids used here.",
 "slots": [
  {
   "id": "disk",
   "title": "slot.disk",
   "min": 1,
   "max": 20,
   "formats": [
    "adf",
    "adz",
    "dms",
    "fdi",
    "ipf"
   ],
   "help": "slot.disk.help",
   "exposedWhen": {
    "not": {
     "setting": "model",
     "in": [
      "CD32",
      "CD32FR",
      "CDTV"
     ]
    }
   }
  },
  {
   "id": "disc",
   "title": "slot.disc",
   "min": 1,
   "max": 1,
   "formats": [
    "cue",
    "iso"
   ],
   "exposedWhen": {
    "setting": "model",
    "in": [
     "CD32",
     "CD32FR",
     "CDTV"
    ]
   },
   "help": "slot.disc.help"
  },
  {
   "id": "savedata",
   "title": "slot.savedata",
   "min": 0,
   "max": 1,
   "formats": [
    "nvr"
   ],
   "exposedWhen": {
    "setting": "model",
    "in": [
     "CD32",
     "CD32FR",
     "CDTV"
    ]
   },
   "help": "slot.savedata.help"
  }
 ]
}
