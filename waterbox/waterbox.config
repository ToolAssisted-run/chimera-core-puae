    ]
   }
  },
  {
   "id": "amiga-os-310-a600.rom",
   "display": "Kickstart 3.1 (40.63) for the A500, A600 and A2000",
   "description": "Commodore's Kickstart 3.1 (40.63) for the A500, A600 and A2000, 512 KB (256 KB for 1.3), for the A600, A2000. Amiga Forever names it amiga-os-310-a600.rom; it is also found as kick40063.A600. It is Commodore's and you have to supply it.",
   "size": 524288,
   "sha1": "3B7F1493B27E212830F989F26CA76C02049F09CA",
   "name": "amiga-os-310-a600.rom",
