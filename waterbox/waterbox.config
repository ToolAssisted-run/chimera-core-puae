{
 "coreName": "PUAE",
 "systemNames": {
  "AMIGA": "Commodore Amiga",
  "CD32": "Amiga CD32",
  "CDTV": "Commodore CDTV"
 },
 "author": "The UAE, WinUAE and PUAE authors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-puae",
 "romFile": "disk",
 "deterministic": true,
 "memoryLayoutMiB": [
  512,
  8,
  16,
  64,
  1024
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. An Amiga has at most 2 MB of chip memory and here up to 8 MB of fast memory more; each disk is held whole in memory (under 2 MB).",
 "video": {
  "_comment": "The BUFFER CAPACITY: PUAE's largest picture, 1440x576. With its defaults a PAL picture is 720x287 (high resolution, one line each), NTSC 720x241; the live size comes from GetVideoWidth/Height. The pixels are twice as tall as they are wide, so the picture is shown at 4:3.",
  "width": 1440,
  "height": 576,
  "vsyncNumerator": 50,
  "vsyncDenominator": 1,
  "_vsync_note": "PUAE runs a PAL Amiga at 50 frames a second and an NTSC one at 59.94; the live rate comes from GetVsyncNumerator/Denominator.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "PUAE's mix, stereo, 44.1 kHz: 882 pairs a PAL frame.",
  "rate": 44100,
  "samplesPerFrame": 4096,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "model",
   "display": "setting.model",
   "type": "enum",
   "options": [
    "A500",
    "A500OG",
    "A500PLUS",
    "A600",
    "A1200OG",
    "A1200",
    "A2000OG",
    "A2000",
    "A4030",
    "A4040",
    "CD32",
    "CD32FR",
    "CDTV"
   ],
   "default": "A500",
   "description": "setting.model.about"
  },
  {
   "name": "kickstart",
   "display": "setting.kickstart",
   "type": "enum",
   "options": [
    "auto",
    "aros"
   ],
   "default": "auto",
   "description": "setting.kickstart.about"
  },
  {
   "name": "video_standard",
   "display": "setting.video_standard",
   "type": "enum",
   "options": [
    "PAL",
    "NTSC"
   ],
   "default": "PAL",
   "description": "setting.video_standard.about"
  },
  {
   "name": "initialTime",
   "display": "setting.initialtime",
   "type": "int",
   "min": 0,
   "max": 2147483647,
   "default": 946684800,
   "description": "setting.initialtime.about"
  },
  {
   "name": "port1",
   "display": "setting.port1",
   "type": "enum",
   "options": [
    "mouse",
    "joystick",
    "none"
   ],
   "default": "mouse",
   "description": "setting.port1.about"
  },
  {
   "name": "port2",
   "display": "common.port_2",
   "type": "enum",
   "options": [
    "joystick",
    "cd32pad",
    "none"
   ],
   "default": "joystick",
   "description": "setting.port2.about",
   "exposedWhen": {
    "not": {
     "setting": "model",
     "in": [
      "CD32",
      "CD32FR"
     ]
    }
   },
   "when": [
    "A500",
    "A500OG",
    "A500PLUS",
    "A600",
    "A1200OG",
    "A1200",
    "A2000OG",
    "A2000",
    "A4030",
    "A4040",
    "CDTV"
   ]
  },
  {
   "name": "port2",
   "display": "common.port_2",
   "type": "enum",
   "options": [
    "joystick",
    "cd32pad",
    "none"
   ],
   "default": "cd32pad",
   "description": "setting.port2.about_2",
   "exposedWhen": {
    "setting": "model",
    "in": [
     "CD32",
     "CD32FR"
    ]
   },
   "when": [
    "CD32",
    "CD32FR"
   ]
  }
 ],
 "_firmware_note": "Each Model's Kickstart ROM, as Amiga Forever names them; none with Kickstart on 'aros', except the CDTV's extended ROM, which AROS has no replacement for. The CD32 has two: the Kickstart and its extended ROM.",
