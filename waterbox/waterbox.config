{
 "coreName": "PUAE",
 "systemNames": {
  "AMIGA": "Commodore Amiga"
 },
 "author": "The UAE, WinUAE and PUAE authors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-puae",
 "romFile": "disk",
 "deterministic": true,
 "memoryLayoutMiB": [
  512,
  8,
  16,
  64,
  1024
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. An Amiga has at most 2 MB of chip memory and here up to 8 MB of fast memory more; each disk is held whole in memory (under 2 MB).",
 "video": {
  "_comment": "The BUFFER CAPACITY: PUAE's largest picture, 1440x576. With its defaults a PAL picture is 720x287 (high resolution, one line each), NTSC 720x241; the live size comes from GetVideoWidth/Height. The pixels are twice as tall as they are wide, so the picture is shown at 4:3.",
  "width": 1440,
  "height": 576,
  "vsyncNumerator": 50,
  "vsyncDenominator": 1,
  "_vsync_note": "PUAE runs a PAL Amiga at 50 frames a second and an NTSC one at 59.94; the live rate comes from GetVsyncNumerator/Denominator.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "PUAE's mix, stereo, 44.1 kHz: 882 pairs a PAL frame.",
  "rate": 44100,
  "samplesPerFrame": 4096,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "model",
   "display": "Model",
   "type": "enum",
   "options": [
    "A500",
    "A500OG",
    "A500PLUS",
    "A600",
    "A1200OG",
    "A1200",
    "A2000OG",
    "A2000",
    "A4030",
    "A4040"
   ],
   "default": "A500",
   "description": "Which Amiga, as PUAE builds it: A500 (Kickstart 1.3, 512 KB chip memory and 512 KB more), A500OG (the same with 512 KB only), A500PLUS (Kickstart 2.04, 1 MB), A600 (Kickstart 3.1, 2 MB and 8 MB of fast memory), A1200OG (Kickstart 3.1, AGA graphics, 2 MB), A1200 (the same and 8 MB of fast memory), A2000OG (Kickstart 1.3), A2000 (Kickstart 3.1, 1 MB), A4030 and A4040 (an A4000 with a 68030 or a 68040, Kickstart 3.1, 2 MB and 8 MB). Each needs its own Kickstart ROM unless Kickstart is 'aros'. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "kickstart",
   "display": "Kickstart",
   "type": "enum",
   "options": [
    "auto",
    "aros"
   ],
   "default": "auto",
   "description": "'auto' is the Kickstart ROM of the Model, which you supply as firmware. 'aros' is AROS's free replacement Kickstart that PUAE carries: nothing has to be supplied, and some games run with it. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "video_standard",
   "display": "Video Standard",
   "type": "enum",
   "options": [
    "PAL",
    "NTSC"
   ],
   "default": "PAL",
   "description": "PAL (50 frames a second, as the European machines) or NTSC (60, as the American ones). Most games were made for PAL. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "port1",
   "display": "Port 1",
   "type": "enum",
   "options": [
    "mouse",
    "joystick",
    "none"
   ],
   "default": "mouse",
   "description": "What is plugged into the Amiga's port 1, the mouse port: a mouse, a joystick (P2's controls, for the games two play with joysticks), or nothing. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "port2",
   "display": "Port 2",
   "type": "enum",
   "options": [
    "joystick",
    "cd32pad",
    "none"
   ],
   "default": "joystick",
   "description": "What is plugged into the Amiga's port 2, the joystick port: a joystick (P1's controls), the CD32's pad (P1's controls and its five more buttons), or nothing. It is part of the machine, so a movie needs the same value."
  }
 ],
 "_firmware_note": "Each Model's Kickstart ROM, as Amiga Forever names them; none with Kickstart on 'aros'.",
 "firmware": [
  {
   "id": "amiga-os-130.rom",
   "display": "Kickstart 1.3 (34.5)",
   "description": "Commodore's Kickstart 1.3 (34.5), 512 KB (256 KB for 1.3), for the A500, A500OG, A2000OG. Amiga Forever names it amiga-os-130.rom; it is also found as kick34005.A500. It is Commodore's and you have to supply it.",
   "size": 262144,
   "sha1": "891E9A547772FE0C6C19B610BAF8BC4EA7FCB785",
   "name": "amiga-os-130.rom",
   "requiredWhen": {
    "all": [
     {
      "setting": "kickstart",
      "is": "auto"
     },
     {
      "setting": "model",
      "in": [
       "A500",
       "A500OG",
       "A2000OG"
      ]
     }
    ]
   }
  },
  {
   "id": "amiga-os-204.rom",
   "display": "Kickstart 2.04 (37.175)",
   "description": "Commodore's Kickstart 2.04 (37.175), 512 KB (256 KB for 1.3), for the A500PLUS. Amiga Forever names it amiga-os-204.rom; it is also found as kick37175.A500. It is Commodore's and you have to supply it.",
   "size": 524288,
   "sha1": "C5839F5CB98A7A8947065C3ED2F14F5F42E334A1",
