+#ifdef CHIMERA_CORE
+/* Chimera: every disk the machine has had in a drive, as it last left it */
+#define CHIMERA_MAX_DISKS 32
+struct chimera_disk { TCHAR name[MAX_DPATH]; uae_u8 *data; size_t size; };
+struct chimera_disk chimera_disks[CHIMERA_MAX_DISKS];
+int chimera_disk_count;
+static int chimera_disk_find (const TCHAR *name)
+{
+	for (int i = 0; i < chimera_disk_count; i++)
+		if (!_tcscmp (chimera_disks[i].name, name))
+			return i;
+	return -1;
+}
+/* what the drive's copy of a disk holds goes back to the table */
+static void chimera_disk_keep (struct zfile *z)
+{
+	size_t len = 0;
+	uae_u8 *data = z ? zfile_get_data_pointer (z, &len) : NULL;
+	int idx = z ? chimera_disk_find (zfile_getname (z)) : -1;
+	if (data && idx >= 0 && len == chimera_disks[idx].size)
+		memcpy (chimera_disks[idx].data, data, len);
+}
+/* for the core's export: every drive's disk back into the table first */
+void chimera_disks_sync (void)
+{
+	for (int i = 0; i < MAX_FLOPPY_DRIVES; i++)
+		chimera_disk_keep (floppy[i].diskfile);
+}
+#endif
