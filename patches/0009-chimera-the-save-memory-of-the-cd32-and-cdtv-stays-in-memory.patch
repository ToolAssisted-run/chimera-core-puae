+#ifdef CHIMERA_CORE
+	/* The save memory is read from the project's file, if there is one, and
+	   then kept in memory only: a run never writes a file, so every run
+	   starts from the same bytes, and Export Save Data takes it out
+	   (chimera_cd32_nvram). */
+	if (path[0] && (cd32_flashfile = zfile_fopen (path, _T("rb"), ZFD_NORMAL))) {
+		size_t size = zfile_fread(cd32_nvram, 1, currprefs.cs_cd32nvram_size, cd32_flashfile);
+		if (size == currprefs.cs_cd32nvram_size && maxlen > currprefs.cs_cd32nvram_size)
+			zfile_fread(cubo_nvram, 1, maxlen - currprefs.cs_cd32nvram_size, cd32_flashfile);
+		zfile_fclose(cd32_flashfile);
+		cd32_flashfile = NULL;
+	}
+#else
 	cd32_flashfile = zfile_fopen (path, _T("rb+"), ZFD_NORMAL);
 	if (!cd32_flashfile)
 		cd32_flashfile = zfile_fopen (path, _T("wb"), 0);
@@ -234,9 +247,19 @@ static void nvram_read (void)
 		if (size < maxlen)
 			zfile_fwrite(cd32_nvram + size, 1, maxlen - size, cd32_flashfile);
 	}
+#endif
 	cd32_eeprom = eeprom_new(cd32_nvram, currprefs.cs_cd32nvram_size, cd32_flashfile);
 }
 
